{
  "name": "ai-challenge-day-12",
  "private": true,
  "scripts": {
    "api": ".venv/bin/python -m uvicorn backend.main:app --reload --host 127.0.0.1 --port 5011",
    "web": "npm --prefix frontend run dev",
    "dev": "concurrently -k -n API,WEB -c blue,magenta \"npm run api\" \"npm run web\"",
    "test": ".venv/bin/python -m pytest backend/test_backend.py -q",
    "build": "npm --prefix frontend run build"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
