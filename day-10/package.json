{
  "name": "ai-challenge-day-10",
  "private": true,
  "scripts": {
    "api": ".venv/bin/python -m uvicorn backend.main:app --reload --host 127.0.0.1 --port 5009",
    "web": "npm --prefix frontend run dev -- --host 127.0.0.1 --port 5176",
    "dev": "concurrently --kill-others-on-fail --names api,web \"npm run api\" \"npm run web\"",
    "test": ".venv/bin/python -m unittest -v backend.test_backend",
    "build": "npm --prefix frontend run build"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
